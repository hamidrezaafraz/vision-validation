<mxfile host="app.diagrams.net">
  <diagram id="group-by-hash-flow" name="7 · group_by_hash">
    <mxGraphModel dx="900" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1410" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="&lt;b&gt;group_by_hash(dataset, …)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;--group_hash, from dataset_cli&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s0" value="&lt;b&gt;Note the settings and start time&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;@audited&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="d0" value="&lt;b&gt;Files already hashed?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;has_hash&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="h1" value="&lt;b&gt;Hash every file's bytes&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;make_hashes · blake2b, 64 KB chunks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="380" y="220" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h2" value="&lt;b&gt;Save manifest.csv&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;save_manifest (hash column)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="380" y="310" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;Bucket the rows not dropped by hash&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;dataset.df.groupby('hash')&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Keep the buckets with 2+ images&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;each one is an exact-copy group&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="d1" value="&lt;b&gt;Any groups?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="530" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Give each group one new group_id&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;group · union-find, uuid4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;Copy the merge into split_group&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;group&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;Pick one survivor per group&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;_select_one_per_group · random, --group_keep_seed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;Mark the survivor keep&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;keep_one_from_group&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b&gt;Mark the other copies drop · exact_duplicate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;keep_one_from_group&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;b&gt;Save manifest.csv&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;save_manifest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s9" value="&lt;b&gt;Log the run in audits.json&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;@audited: groups_found, images_in_groups, flag changes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b&gt;Back to dataset_cli&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="n1" value="&lt;b&gt;Same hash = same file&lt;/b&gt;&lt;br&gt;Equal hashes are trusted; the bytes are not compared again. (find_strict_duplicates in src/exact_duplicates does that, but is not used here.)" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="430" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;Who can be picked&lt;/b&gt;&lt;br&gt;Only rows not already review or drop. A copy flagged review is neither kept nor dropped, so it stays alongside the survivor." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="850" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;Side effect&lt;/b&gt;&lt;br&gt;This runs over every group_id, so every unflagged image becomes keep, not only the survivors of duplicate groups." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="950" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue: in memory&lt;br&gt;green: touches disk (resultdir)&lt;br&gt;yellow: decision&lt;br&gt;orange: flag added (action · reason tag)&lt;br&gt;&lt;font color='#666666'&gt;grey text: the function that does it&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="20" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="ex" value="&lt;b&gt;Example&lt;/b&gt;&lt;br&gt;a.png, b.png, c.png have the same hash&lt;br&gt;→ one group_id for all three&lt;br&gt;→ random pick: b.png&lt;br&gt;→ b.png keep&lt;br&gt;→ a.png, c.png drop · exact_duplicate" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="160" width="250" height="160" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="s0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s0" target="d0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d0" target="h1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="h2" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d1" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d1" target="s9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="580"/><mxPoint x="355" y="1250"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
