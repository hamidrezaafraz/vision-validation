<mxfile host="app.diagrams.net">
  <diagram id="dataset-fingerprint-flow" name="16 · dataset_fingerprint">
    <mxGraphModel dx="900" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="1530" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="&lt;b&gt;dataset_fingerprint(manifest, data_dir, base_dir)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;build_report · the report's 'dataset' block&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;Default base_dir to the current folder&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.getcwd&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Make data_dir absolute&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.path.abspath&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="d1" value="&lt;b&gt;Does every row have a file hash?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;the hash column, none empty&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="mc" value="&lt;b&gt;Method 'content': use the file hashes&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;the bytes themselves&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="mm" value="&lt;b&gt;Method 'size_mtime': use modification times&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;a copied folder gets new times&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=20;" vertex="1" parent="1"><mxGeometry x="380" y="440" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="d2" value="&lt;b&gt;Another manifest row?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Resolve its path against base_dir&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.path.join · abspath&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="d3" value="&lt;b&gt;Does the file still exist?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.stat&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="miss" value="&lt;b&gt;Count it as missing and leave it out&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;missing_files&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="380" y="810" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;Add its size to the total&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;st_size → total_bytes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;Take its content: file hash or modification time&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;depends on the method&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;Record: relative path · size · content&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.path.relpath, joined by \0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b&gt;Sort the records&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;so row order doesn't matter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;b&gt;Hash them in that order&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;hashlib.blake2b · 16 bytes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1330" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b&gt;Return the fingerprint&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;fingerprint, method, file_count, total_bytes, missing_files&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="1430" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue: in memory&lt;br&gt;green: reads disk (file metadata only)&lt;br&gt;yellow: decision&lt;br&gt;orange: weaker method&lt;br&gt;&lt;font color='#666666'&gt;grey text: the library call or an example&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="20" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="why" value="&lt;b&gt;What it is for&lt;/b&gt;&lt;br&gt;One id for the delivery the report describes. Same files → same fingerprint; one changed, added or removed file → a different one. A client can check that a report belongs to the data they have." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="160" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="rel" value="&lt;b&gt;Why relative paths&lt;/b&gt;&lt;br&gt;Paths are relative to data_dir, so the same delivery in another folder or on another machine gets the same fingerprint (with the content method), and no local paths leak." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="340" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="vs" value="&lt;b&gt;Compare: paths_digest&lt;/b&gt;&lt;br&gt;blake2b over the sorted paths only, with no file I/O. It goes in every audits.json entry, and the report uses it to tell whether a check ran on the same set of files. dataset_fingerprint also covers sizes and content, so it notices a file that changed in place." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="700" width="280" height="170" as="geometry"/></mxCell>
        <mxCell id="ex" value="&lt;b&gt;Example output&lt;/b&gt; (illustrative)&lt;br&gt;fingerprint: 3f9a…c21e&lt;br&gt;method: content&lt;br&gt;file_count: 59,100&lt;br&gt;missing_files: 0" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="1240" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d1" target="mc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="mm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="mc" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="mm" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3" target="miss"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="next row" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.3;" edge="1" parent="1" source="miss" target="d2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="840"/><mxPoint x="700" y="580"/></Array></mxGeometry></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.3;" edge="1" parent="1" source="s6" target="d2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="1150"/><mxPoint x="700" y="580"/></Array></mxGeometry></mxCell>
        <mxCell id="e15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="s7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="600"/><mxPoint x="20" y="1270"/></Array></mxGeometry></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s8" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
