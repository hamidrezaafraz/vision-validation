<mxfile host="app.diagrams.net">
  <diagram id="write-review-sheet-flow" name="19 · write_review_sheet">
    <mxGraphModel dx="900" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="before" value="&lt;b&gt;Before this&lt;/b&gt;&lt;br&gt;generate_report deletes any old review_sheet.html first, so a failure never leaves an earlier run's sheet behind." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b&gt;write_review_sheet(page, path)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;generate_report, after build_review_sheet&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;Find the folder the sheet goes in&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.path.abspath · dirname&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Create the folder if it doesn't exist&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.makedirs(exist_ok=True)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Create a temporary file in that folder&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;tempfile.mkstemp · .review-….html&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;Write the page into it as UTF-8&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.fdopen · write&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;Rename it over review_sheet.html&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.replace · one atomic step&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b&gt;Done&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;the new sheet is in place&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="e1" value="&lt;b&gt;Delete the temporary file, if it exists&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.remove&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="380" y="425" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="e2" value="&lt;b&gt;Raise the error again&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;BaseException: also Ctrl-C&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=20;" vertex="1" parent="1"><mxGeometry x="380" y="520" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="caller" value="&lt;b&gt;generate_report decides&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;--force: a review_sheet_failed issue, valid false · otherwise the run stops&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="380" y="620" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue: in memory&lt;br&gt;green: touches disk (resultdir/report/)&lt;br&gt;red: an error, passed on to the caller&lt;br&gt;dashed red arrow: if this step raises&lt;br&gt;&lt;font color='#666666'&gt;grey text: the library call&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="20" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="why" value="&lt;b&gt;Why a temp file and a rename&lt;/b&gt;&lt;br&gt;os.replace swaps the file in one step, so anyone opening review_sheet.html sees either no sheet or a complete one, never half a page, even if the run crashes or is stopped mid-write." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="170" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="same" value="&lt;b&gt;Why the same folder&lt;/b&gt;&lt;br&gt;A rename is only atomic within one file system, so the temp file is made next to the target, not in /tmp." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="350" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="pattern" value="&lt;b&gt;Same pattern elsewhere&lt;/b&gt;&lt;br&gt;write_report (validation_report.json) and append_audit (audits.json) write the same way." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="490" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="perm" value="&lt;b&gt;Side effect: owner-only files&lt;/b&gt;&lt;br&gt;mkstemp creates the file readable by its owner only (mode 600), and the rename keeps that, so every report file is -rw-------. Fine on your own machine; others can't open them." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="630" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s5" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="s4" target="e1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="s5" target="e1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="e1" target="e2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="e2" target="caller"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
