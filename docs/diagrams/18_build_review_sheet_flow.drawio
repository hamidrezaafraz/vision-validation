<mxfile host="app.diagrams.net">
  <diagram id="build-review-sheet-flow" name="18 · build_review_sheet">
    <mxGraphModel dx="900" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="2150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="&lt;b&gt;build_review_sheet(manifest, report, data_dir, base_dir, …)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;generate_report, with --review_sheet&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;Give each row its relative path, absolute path, status and reason&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;_rows&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s2" value="tag_sections" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="340" height="370" as="geometry"/></mxCell>
        <mxCell id="h_s2_0" value="&lt;b&gt;Every tag that isn't a duplicate tag, most severe first&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;_tag_order&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s2"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s2_1" value="&lt;b&gt;The rows carrying it, worst first&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;tag_metric · worst_first_key · e.g. lowest blur_score first&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s2"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s2_2" value="&lt;b&gt;Keep the first 60&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;max_per_section&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s2"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s2_3" value="&lt;b&gt;Caption each tile with its metric value&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;e.g. blur_score = 12.3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s2"><mxGeometry x="20" y="290" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Make one section per flag&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;tag_sections&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s3" value="group_sections" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="520" width="340" height="370" as="geometry"/></mxCell>
        <mxCell id="h_s3_0" value="&lt;b&gt;For each grouping column in the report's duplicates section&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;report['duplicates']&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s3"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s3_1" value="&lt;b&gt;Chaining suspects first, then the largest groups&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;repeats skipped · up to 5 groups&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s3"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s3_2" value="&lt;b&gt;Kept member first, at most 12 members&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;'N more not shown'&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s3"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s3_3" value="&lt;b&gt;Add the size, folders, mean cosine and suspect badge&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;from the report&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s3"><mxGeometry x="20" y="290" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Make the duplicate-group sections&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;group_sections&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="675" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s4" value="baseline_section" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="920" width="340" height="210" as="geometry"/></mxCell>
        <mxCell id="h_s4_0" value="&lt;b&gt;Take every row whose status is ok&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s4"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s4_1" value="&lt;b&gt;Sample 60 with seed 0, sorted by path&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;the same sample on every run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s4"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;Pick a sample of unflagged images&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;baseline_section&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="995" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;Collect every image the page will show&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;items from the three kinds of sections&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1075" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s6" value="make_thumbnails" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="1160" width="340" height="370" as="geometry"/></mxCell>
        <mxCell id="h_s6_0" value="&lt;b&gt;Take each distinct path once&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;sorted set&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s6"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s6_1" value="&lt;b&gt;Open and fully decode it; give up if it fails&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;thumbnail_uri → None&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="h_s6"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s6_2" value="&lt;b&gt;Convert it to RGB&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;_to_rgb · alpha on white, 16-bit stretched to 0–255&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s6"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s6_3" value="&lt;b&gt;Shrink to 128 px and encode as JPEG&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;quality 70 · base64 data: URI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s6"><mxGeometry x="20" y="290" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;Make the thumbnails in parallel&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;make_thumbnails · 8 threads&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1315" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b&gt;Take the header details from the report&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;generated_at · file_count · fingerprint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1395" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s8" value="render_html" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="1560" width="340" height="450" as="geometry"/></mxCell>
        <mxCell id="h_s8_0" value="&lt;b&gt;Header and navigation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;time, file count, fingerprint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s8"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s8_1" value="&lt;b&gt;Flags: one grid per tag&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;e.g. '60 of 412 shown, worst first by blur_score'&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s8"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s8_2" value="&lt;b&gt;Duplicate groups: one grid per group&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;kept image in green&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s8"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s8_3" value="&lt;b&gt;Baseline: one grid of the sample&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s8"><mxGeometry x="20" y="290" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s8_4" value="&lt;b&gt;Each tile: the image or 'could not be decoded'&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;_tile · path · status · caption&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s8"><mxGeometry x="20" y="370" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;b&gt;Render the page&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;render_html&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1755" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b&gt;Return (HTML page, number of tiles)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;generate_report writes it: write_review_sheet&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="2050" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue: in memory&lt;br&gt;green: reads the image files&lt;br&gt;purple: start / result&lt;br&gt;box with a title: one helper function&lt;br&gt;&lt;font color='#666666'&gt;grey text: function, setting or example&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="20" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="same" value="&lt;b&gt;Same groups as the JSON&lt;/b&gt;&lt;br&gt;Groups are taken from report['duplicates'], not recomputed, so the sheet shows exactly the groups, sizes and similarities the report states." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="160" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="self" value="&lt;b&gt;One self-contained file&lt;/b&gt;&lt;br&gt;Thumbnails are embedded as data: URIs and paths are relative to data_dir, so the page can be sent to a client: no links to local files, nothing to load." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="1200" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="exif" value="&lt;b&gt;Stored pixels&lt;/b&gt;&lt;br&gt;EXIF rotation is not applied, so an exif_rotated image shows as it is stored." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="1370" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="count" value="&lt;b&gt;The returned count&lt;/b&gt;&lt;br&gt;It counts tiles: an image shown in two sections counts twice, and a tile that couldn't be decoded counts too." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="1500" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="h_s2_0" target="h_s2_1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="h_s2_1" target="h_s2_2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="h_s2_2" target="h_s2_3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
