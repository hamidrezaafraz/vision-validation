<mxfile host="app.diagrams.net">
  <diagram id="duplicate-statistics-flow" name="15 · duplicate_statistics">
    <mxGraphModel dx="900" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="&lt;b&gt;duplicate_statistics(manifest, data_dir, base_dir, embeddings, …)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;build_report · section 'duplicates'&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;Pick the default similarity model&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;the first model by name, if none was given&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Give each row its relative path, folder and status&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;relative_paths · relative_folders · resolve_status&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s3" value="grouping_columns" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="160" width="340" height="210" as="geometry"/></mxCell>
        <mxCell id="h_s3_0" value="&lt;b&gt;hash, group_id and split_group, if present&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;exact · duplicate · split&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s3"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s3_1" value="&lt;b&gt;then every group_&amp;lt;model&amp;gt;_&amp;lt;threshold&amp;gt; column&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;embedding_columns · e.g. group_alexnet_0_95&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s3"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Find the columns that define groups&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;grouping_columns&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s4" value="column_statistics · once per column" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="400" width="340" height="610" as="geometry"/></mxCell>
        <mxCell id="h_s4_0" value="&lt;b&gt;Read each row's group in this column&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;group_labels · an empty hash gets a group of its own&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s4"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s4_1" value="&lt;b&gt;Size the groups; keep those with 2+ members&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;redundancy · groups, redundant, unique&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s4"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s4_2" value="&lt;b&gt;Set the size above which a group looks chained&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;suspect_threshold · 50, or p99.9 with 1,000+ groups&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s4"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s4_3" value="&lt;b&gt;Pick the model for similarity&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;model_for_column · the column's own model, else the default&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s4"><mxGeometry x="20" y="290" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s4_4" value="&lt;b&gt;Describe the 20 largest groups and every suspect&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;describe_group · size, folders, status, kept, members&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s4"><mxGeometry x="20" y="370" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s4_5" value="&lt;b&gt;Mean cosine similarity inside each described group&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;mean_pairwise_similarity · low = a chain, not copies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s4"><mxGeometry x="20" y="450" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s4_6" value="&lt;b&gt;Count groups that span several folders&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;cross_folder · and the most common folder pairs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s4"><mxGeometry x="20" y="530" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;Describe the groups of each column&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;columns · column_statistics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="675" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s5" value="levels" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="1040" width="340" height="450" as="geometry"/></mxCell>
        <mxCell id="h_s5_0" value="&lt;b&gt;Levels: exact (hash), + perceptual (group_id), + each embedding column&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s5"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s5_1" value="&lt;b&gt;Join the groups of every column so far&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;union_groups · a~b in any column → one group&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s5"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s5_2" value="&lt;b&gt;Count groups, redundant copies and unique images&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;redundancy · redundant = members − groups&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s5"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s5_3" value="&lt;b&gt;What this level adds over the previous one&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;added_redundant&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s5"><mxGeometry x="20" y="290" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s5_4" value="&lt;b&gt;Does the last level group rows like split_group?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;same_partition · matches_split_group&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s5"><mxGeometry x="20" y="370" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;Measure redundancy level by level&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;levels · matches_split_group&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1235" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;List the models used for similarity&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;similarity_models&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1315" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b&gt;Return the duplicates section&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;a JSON-ready dict&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="1530" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue: in memory (nothing here changes the manifest)&lt;br&gt;purple: start / result&lt;br&gt;box with a title: one helper function&lt;br&gt;&lt;font color='#666666'&gt;grey text: output key · function, or an example&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="20" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="red" value="&lt;b&gt;Redundant copies&lt;/b&gt;&lt;br&gt;A group of 3 identical images has 2 redundant copies: only one is needed. Unique = all rows − redundant. Dropped rows are counted too, because the copies are the dropped rows." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="160" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="chain" value="&lt;b&gt;Chaining suspects&lt;/b&gt;&lt;br&gt;Groups follow links, so a~b and b~c join a and c even when they look different. Unusually large groups are marked chaining_suspect, to be checked in the review sheet rather than trusted." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="500" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="cos" value="&lt;b&gt;Fast mean similarity&lt;/b&gt;&lt;br&gt;With unit vectors u, the sum over all pairs is |Σu|² − n, so the mean needs one pass over the group (n × dim), not all n² pairs." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="670" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="ex" value="&lt;b&gt;Example&lt;/b&gt;&lt;br&gt;a and b have the same hash; b and c the same pHash group.&lt;br&gt;exact: 1 group {a, b} → 1 redundant&lt;br&gt;+ perceptual: {a, b, c} → 2 redundant, added 1&lt;br&gt;The levels are built on a copy; split_group is only compared, never changed." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="1170" width="280" height="170" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="h_s3_0" target="h_s3_1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
