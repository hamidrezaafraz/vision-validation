                <mxCell id="A7" parent="laneA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;SystemExit&lt;/b&gt;&lt;br&gt;&#39;--review_sheet, --force … only apply to the report; add --report.&#39;" vertex="1">
