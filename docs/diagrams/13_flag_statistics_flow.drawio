<mxfile host="app.diagrams.net">
  <diagram id="flag-statistics-flow" name="13 · flag_statistics">
    <mxGraphModel dx="900" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="2175" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="&lt;b&gt;flag_statistics(manifest, top_combinations)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;build_report · section 'flags'&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;Count every row, dropped ones included&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;total_images&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Count rows per final status&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;status · status_counts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="245" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Count images with at least one tag&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;images_flagged · row_tags&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="565" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;Add the overlap note&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;note · never sum the per-tag counts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;Count each tag&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;tags · tag_counts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;Count images per severity&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;severity · severity_counts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1325" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b&gt;Count pairs of tags on the same image&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;cooccurrence · cooccurrence_pairs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1645" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;b&gt;Count the exact tag sets&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;combinations · tag_combinations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1965" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b&gt;Return the flags section&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;a JSON-ready dict&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="2085" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="status" value="status_counts" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="170" width="340" height="210" as="geometry"/></mxCell>
        <mxCell id="status0" value="&lt;b&gt;Turn each action into ok, review or drop&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;resolve_status · '' and keep → ok; unknown → ValueError&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="status"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="status1" value="&lt;b&gt;Share of all rows per status&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;share · the three add up to the total&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="status"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="rowtags" value="row_tags · used by every count below" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="410" width="340" height="370" as="geometry"/></mxCell>
        <mxCell id="rowtags0" value="&lt;b&gt;Split each reason at ';'&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;parse_tags&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="rowtags"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="rowtags1" value="&lt;b&gt;Rename each tag to the name it is counted under&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;canonical_tag · old aliases → catalog tag; near_duplicate_phash_4 kept as is&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="rowtags"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="rowtags2" value="&lt;b&gt;Drop a tag written twice in one row&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;set&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="rowtags"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="rowtags3" value="&lt;b&gt;One entry per (row, tag); untagged rows drop out&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;explode&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="rowtags"><mxGeometry x="20" y="290" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="tagcounts" value="tag_counts" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="810" width="340" height="370" as="geometry"/></mxCell>
        <mxCell id="tagcounts0" value="&lt;b&gt;Count rows per tag, most frequent first&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;row_tags · value_counts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="tagcounts"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="tagcounts1" value="&lt;b&gt;Add each tag's category and severity&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;tag_info · 'unknown' if not in the catalog&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="tagcounts"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="tagcounts2" value="&lt;b&gt;Share of all rows&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;share&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="tagcounts"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="tagcounts3" value="&lt;b&gt;Split each tag's rows by final status&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;by_status · shows which policy was used&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="tagcounts"><mxGeometry x="20" y="290" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="sev" value="severity_counts" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="1210" width="340" height="290" as="geometry"/></mxCell>
        <mxCell id="sev0" value="&lt;b&gt;Give every tag its severity&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;tag_info&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="sev"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="sev1" value="&lt;b&gt;any: images with at least one tag of that severity&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;these overlap and don't add up&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="sev"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="sev2" value="&lt;b&gt;worst: each image by its most serious tag&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;error &gt; warning &gt; info &gt; unknown · adds up to images_flagged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="sev"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="cooc" value="cooccurrence_pairs" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="1530" width="340" height="290" as="geometry"/></mxCell>
        <mxCell id="cooc0" value="&lt;b&gt;Count images for every pair of tags&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;cooccurrence_matrix · one-hot Mᵀ·M, diagonal = each tag's count&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="cooc"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="cooc1" value="&lt;b&gt;Keep the pairs that share an image, most first&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;share of all rows&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="cooc"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="cooc2" value="&lt;b&gt;given: share of each tag's images that carry the other&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;e.g. 2 of 3 too_small images are also blurry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="cooc"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="combo" value="tag_combinations" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="1850" width="340" height="290" as="geometry"/></mxCell>
        <mxCell id="combo0" value="&lt;b&gt;Collect each image's exact set of tags&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;sorted tuple&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="combo"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="combo1" value="&lt;b&gt;Count how many images have each set&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;value_counts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="combo"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="combo2" value="&lt;b&gt;Return the number of sets and the most common ones&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;distinct · top (top_combinations, 10)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="combo"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue: in memory (nothing here writes or changes the manifest)&lt;br&gt;purple: start / result&lt;br&gt;box with a title: one helper function&lt;br&gt;&lt;font color='#666666'&gt;grey text: output key · function, or an example&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="20" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="share" value="&lt;b&gt;share(count, of)&lt;/b&gt;&lt;br&gt;Every number is {count, of, pct}: of is what it is a share of, pct has 2 decimals, and pct is 0 when of is 0. Shares of the delivery use every row, dropped ones included." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="160" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="ex" value="&lt;b&gt;Example&lt;/b&gt; (the tests' 10 rows)&lt;br&gt;status: 4 ok, 3 review, 3 drop&lt;br&gt;images_flagged: 6 of 10&lt;br&gt;tags: blurry 3, too_small 3, exact_duplicate 2, corrupt 1&lt;br&gt;→ 9 tags on 6 images, so never sum them&lt;br&gt;pair blurry + too_small: 2 images&lt;br&gt;given too_small: 2 of 3 (66.67%)&lt;br&gt;combinations: 5 distinct sets" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="410" width="280" height="230" as="geometry"/></mxCell>
        <mxCell id="unk" value="&lt;b&gt;Unknown tags&lt;/b&gt;&lt;br&gt;A tag missing from the catalog is still counted, as written, with category and severity 'unknown', so a report built with --force shows it. validate_manifest reports it as an error." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="810" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="status"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="rowtags"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s5" target="tagcounts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s6" target="sev"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s7" target="cooc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s8" target="combo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s8" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="status0" target="status1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="rowtags0" target="rowtags1"><mxGeometry relative="1" as="geometry"/></mxCell>
