        <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="sev0" target="sev1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="sev1" target="sev2"><mxGeometry relative="1" as="geometry"/></mxCell>
