<mxfile host="app.diagrams.net">
  <diagram id="group-by-embeddings-flow" name="9 · group_by_embeddings">
    <mxGraphModel dx="900" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="&lt;b&gt;group_by_embeddings(dataset, model_name, threshold)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;--group_embeddings (alexnet) · --group_expert_embeddings (each facenet model)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="pre" value="&lt;b&gt;Hash the files first, if not hashed yet&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;dataset_cli · make_hashes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s0" value="&lt;b&gt;Note the settings and start time&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;@audited&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;Load the cached embeddings of the rows not dropped&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;load_embeddings · embeddings/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="d0" value="&lt;b&gt;Cache covers these rows?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="emb" value="Compute them · make_and_save_embeddings" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="380" y="360" width="320" height="460" as="geometry"/></mxCell>
        <mxCell id="e1" value="&lt;b&gt;Load the pretrained model without its classifier&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;get_model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="emb"><mxGeometry x="20" y="50" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="e2" value="&lt;b&gt;Resize images the way the model expects&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;get_transform · 224 px / 160 px&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="emb"><mxGeometry x="20" y="130" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="e3" value="&lt;b&gt;Run every image not dropped through it, in batches&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;get_embeddings · --embedding_batch_size / --domain_expert_batch_size&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="emb"><mxGeometry x="20" y="210" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="e4" value="&lt;b&gt;Scale every vector to length 1&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;F.normalize&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="emb"><mxGeometry x="20" y="290" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="e5" value="&lt;b&gt;Save the embeddings and their row ids&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;save_embeddings · embeddings/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="emb"><mxGeometry x="20" y="370" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Compare every pair by cosine similarity&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;similar_pairs · chunked matmul on GPU/CPU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Keep pairs with similarity ≥ threshold&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;--embedding_threshold / --domain_expert_threshold · 0.95&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="d1" value="&lt;b&gt;Any pairs?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="710" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;Join chained pairs into groups&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;merge_pairs · a~b and b~c → {a, b, c}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;Map embedding positions back to manifest rows&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;get_idx2idx&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;Merge each group in the model's own column&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;group · group_&amp;lt;model&amp;gt;_&amp;lt;threshold&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b&gt;Merge the same groups into split_group&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;group&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;b&gt;Save manifest.csv&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;save_manifest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s9" value="&lt;b&gt;Log the run in audits.json&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;@audited: pairs_found, groups_found, images_in_groups, group_column&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1310" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b&gt;Back to dataset_cli&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;next model, if several&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue: in memory&lt;br&gt;green: touches disk (resultdir)&lt;br&gt;yellow: decision&lt;br&gt;&lt;font color='#666666'&gt;grey text: the function that does it&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="20" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="what" value="&lt;b&gt;What an embedding is&lt;/b&gt;&lt;br&gt;A list of numbers describing what the image shows. Similar images point the same way, so their cosine similarity is close to 1.&lt;br&gt;alexnet: general look, 9,216 numbers.&lt;br&gt;facenet: whose face it is, 512 numbers." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="160" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="none" value="&lt;b&gt;Nothing is flagged or dropped&lt;/b&gt;&lt;br&gt;Unlike the hash steps, this leaves group_id, action and reason alone. split_group only keeps look-alikes in the same train/val/test split." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="990" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="col" value="&lt;b&gt;One column per model&lt;/b&gt;&lt;br&gt;group_alexnet_0_95, group_facenet-vggface2_0_95, … record which model linked the images. restart resets them; split_group is the union of all of them." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="1140" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="pre"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="pre" target="s0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="d0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="d0" target="emb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="e1" target="e2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="e2" target="e3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="e3" target="e4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="e4" target="e5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.95;entryX=1;entryY=0.5;" edge="1" parent="1" source="emb" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d0" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d1" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d1" target="s9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="760"/><mxPoint x="355" y="1340"/></Array></mxGeometry></mxCell>
