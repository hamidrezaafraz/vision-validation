<mxfile host="app.diagrams.net">
  <diagram id="dataset-profile-flow" name="14 · dataset_profile">
    <mxGraphModel dx="900" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="2780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="&lt;b&gt;dataset_profile(manifest, data_dir, base_dir, checks, …)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;build_report · section 'profile'&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s1" value="file_sizes" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="340" height="210" as="geometry"/></mxCell>
        <mxCell id="h_s1_0" value="&lt;b&gt;Resolve each path against base_dir&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;_abs_paths&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s1"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s1_1" value="&lt;b&gt;Read its size; NaN if the file is gone&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.stat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="h_s1"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;Measure each file's size on disk&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;file_sizes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s2" value="decodable_mask" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="360" width="340" height="210" as="geometry"/></mxCell>
        <mxCell id="h_s2_0" value="&lt;b&gt;No is_decodable column: every row counts&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;check_decode didn't run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s2"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s2_1" value="&lt;b&gt;Leave out rows marked false or 0&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;their 0×0 placeholder sizes would distort every metric&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s2"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Find the rows that decoded&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;decodable_mask&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="435" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Count files, total bytes and missing files&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;files&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="515" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;Share of decodable and undecodable rows&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;decodable · undecodable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="595" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s5" value="extension_formats" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="600" width="340" height="290" as="geometry"/></mxCell>
        <mxCell id="h_s5_0" value="&lt;b&gt;Take decodable rows that have a format&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;the format column from check_decode&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s5"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s5_1" value="&lt;b&gt;Count every (extension, format) pair&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;table&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s5"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s5_2" value="&lt;b&gt;mismatched: a known format with the wrong extension&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;e.g. a PNG named .jpg · other formats → unchecked_formats&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s5"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;Compare each file's extension with its real format&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;extensions · extension_formats&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="715" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s6" value="categorical_counts" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="920" width="340" height="290" as="geometry"/></mxCell>
        <mxCell id="h_s6_0" value="&lt;b&gt;For format, color_mode, channels, dtype, bit depth, alpha, EXIF&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;missing column → unavailable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s6"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s6_1" value="&lt;b&gt;Share of decodable rows per value, most common first&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;share&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s6"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s6_2" value="&lt;b&gt;Count empty values as missing&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;missing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s6"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;Count the values of each categorical metric&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;categorical · categorical_counts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1035" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s7" value="numeric_distributions" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="1240" width="340" height="290" as="geometry"/></mxCell>
        <mxCell id="h_s7_0" value="&lt;b&gt;File size over every file that exists&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;decodable or not&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s7"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s7_1" value="&lt;b&gt;Other metrics over decodable rows only&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;numeric_column · empty or infinite → NaN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s7"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s7_2" value="&lt;b&gt;count, min, p1, p5, median, p95, p99, max, mean + a histogram&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;distribution · 20 bins&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s7"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b&gt;Summarize each numeric metric&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;distributions · numeric_distributions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1355" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s8" value="top_resolutions" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="1560" width="340" height="210" as="geometry"/></mxCell>
        <mxCell id="h_s8_0" value="&lt;b&gt;Count each exact width × height among decodable rows&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s8"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s8_1" value="&lt;b&gt;Return how many distinct sizes, and the top 10&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;distinct · top&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s8"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;b&gt;Find the most common resolutions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;resolutions · top_resolutions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1635" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s9" value="threshold_sensitivity" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="1800" width="340" height="450" as="geometry"/></mxCell>
        <mxCell id="h_s9_0" value="&lt;b&gt;For each threshold the checks use&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;THRESHOLDS · min_width … min_blur_score&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s9"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s9_1" value="&lt;b&gt;Read the value its check really ran with&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;last_ok_params · audits.json, not the defaults; none → unavailable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="h_s9"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s9_2" value="&lt;b&gt;Skip rows another threshold already handled&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;excluded_by · blank frames, for clipping and blur&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s9"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s9_3" value="&lt;b&gt;flagged: rows on the flagged side&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;same comparison as the check, so it matches the tags&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s9"><mxGeometry x="20" y="290" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s9_4" value="&lt;b&gt;borderline: rows within 10% of the threshold&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;split into borderline_flagged and borderline_passing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s9"><mxGeometry x="20" y="370" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s9" value="&lt;b&gt;Count the images near each threshold&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;thresholds · threshold_sensitivity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1995" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s10" value="folder_breakdown" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="2280" width="340" height="370" as="geometry"/></mxCell>
        <mxCell id="h_s10_0" value="&lt;b&gt;Find each row's folder relative to data_dir&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;relative_folders · '.' = top level&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s10"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s10_1" value="&lt;b&gt;Per folder: share of images, share flagged, top tag&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;folders · row_tags&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s10"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s10_2" value="&lt;b&gt;Images per folder depth&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;depths&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s10"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s10_3" value="&lt;b&gt;Per tag: the folder holding most of it&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;tag_concentration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s10"><mxGeometry x="20" y="290" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s10" value="&lt;b&gt;Break the images down by folder&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;folders · folder_breakdown&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="2435" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b&gt;Return the profile section&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;a JSON-ready dict&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="2690" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue: in memory (nothing here changes the manifest)&lt;br&gt;green: reads disk&lt;br&gt;purple: start / result&lt;br&gt;box with a title: one helper function&lt;br&gt;&lt;font color='#666666'&gt;grey text: output key · function, or an example&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="20" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="why" value="&lt;b&gt;What the profile is for&lt;/b&gt;&lt;br&gt;With no labels, this is most of the analysis: it tells the client what they sent, independent of how it was flagged, and shows how solid each threshold is." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="170" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="dec" value="&lt;b&gt;Decodable rows only&lt;/b&gt;&lt;br&gt;Image metrics leave out undecodable files, which are counted separately. A missing column is reported as unavailable, never guessed." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="330" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="thr" value="&lt;b&gt;Borderline example&lt;/b&gt;&lt;br&gt;min_blur_score 40 → band 36 to 44. Images in the band would change flag if the threshold moved by 10%, so many borderline images mean the count depends on the exact setting." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="1950" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="h_s1_0" target="h_s1_1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1" target="h_s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="h_s2_0" target="h_s2_1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="h_s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="h_s5_0" target="h_s5_1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="h_s5_1" target="h_s5_2"><mxGeometry relative="1" as="geometry"/></mxCell>
