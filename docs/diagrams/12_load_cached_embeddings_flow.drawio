<mxfile host="app.diagrams.net">
  <diagram id="load-cached-embeddings-flow" name="12 · load_cached_embeddings">
    <mxGraphModel dx="900" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="1440" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="&lt;b&gt;load_cached_embeddings(manifest, embeddings_dir)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;build_report, when use_embeddings is on&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="d0" value="&lt;b&gt;embeddings/ folder exists?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="r0" value="&lt;b&gt;Return: no models, nothing unavailable&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;{} and []&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;List the files ending in _embeddings.npy&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.listdir, sorted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="d1" value="&lt;b&gt;Another embeddings file?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Take the model name from the file name&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;alexnet_embeddings.npy → alexnet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="d2" value="&lt;b&gt;Has a row-ids file?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;&amp;lt;model&amp;gt;_embeddings_indices.npy&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="u1" value="&lt;b&gt;Unavailable: rows can't be matched to the manifest&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;no indices file&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=20;" vertex="1" parent="1"><mxGeometry x="380" y="610" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Memory-map the matrix and load the row ids&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;np.load(mmap_mode='r')&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="d3" value="&lt;b&gt;2-D, with one row id per row?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="u2" value="&lt;b&gt;Unavailable: N embedding rows but M indices&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;length mismatch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=20;" vertex="1" parent="1"><mxGeometry x="380" y="850" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="d4" value="&lt;b&gt;Every row id still in the manifest?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="980" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="u3" value="&lt;b&gt;Unavailable: refers to rows not in the manifest&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;the manifest was rebuilt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=20;" vertex="1" parent="1"><mxGeometry x="380" y="1000" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;Keep it: model → (matrix, row ids)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;found[model]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="ret" value="&lt;b&gt;Return (found, unavailable)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="use1" value="&lt;b&gt;Mean similarity inside each duplicate group&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;duplicate_statistics · mean_pairwise_similarity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="use2" value="&lt;b&gt;Listed in the JSON&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;duplicates.similarity_unavailable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="380" y="1340" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue: in memory&lt;br&gt;green: reads disk (resultdir/embeddings/)&lt;br&gt;yellow: decision&lt;br&gt;orange: model listed as unavailable&lt;br&gt;&lt;font color='#666666'&gt;grey text: the function or an example&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="20" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="why" value="&lt;b&gt;Never matched by position&lt;/b&gt;&lt;br&gt;Row i of an old matrix was the i-th kept row when it was made; after a rerun that is a different image. Matched by position, identical files scored a cosine of 0.17–0.36, so without row ids the model is skipped instead." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="170" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="mmap" value="&lt;b&gt;Memory-mapped&lt;/b&gt;&lt;br&gt;The alexnet file is about 1 GB. Only the rows of the groups being described are read from disk, not the whole matrix." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="350" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="part" value="&lt;b&gt;Partial caches are fine&lt;/b&gt;&lt;br&gt;Unlike the dataset's load_embeddings, not every row needs an embedding. Rows without one are left out of a group's similarity, and members_with_embeddings says how many counted." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="490" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="d0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d0" target="r0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="u1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3" target="u2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d4" target="u3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d4" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="next file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="u1" target="d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="640"/><mxPoint x="700" y="400"/></Array></mxGeometry></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="u2" target="d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="880"/><mxPoint x="700" y="400"/></Array></mxGeometry></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="u3" target="d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="1030"/><mxPoint x="700" y="400"/></Array></mxGeometry></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s4" target="d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="1160"/><mxPoint x="700" y="400"/></Array></mxGeometry></mxCell>
        <mxCell id="e17" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="ret"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="400"/><mxPoint x="20" y="1270"/></Array></mxGeometry></mxCell>
        <mxCell id="e18" value="found" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ret" target="use1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="unavailable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="ret" target="use2"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
