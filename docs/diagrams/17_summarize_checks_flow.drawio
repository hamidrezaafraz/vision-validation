<mxfile host="app.diagrams.net">
  <diagram id="summarize-checks-flow" name="17 · summarize_checks">
    <mxGraphModel dx="900" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="1370" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="&lt;b&gt;summarize_checks(checks, manifest)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;build_report · the report's 'checks' key&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;Fingerprint the current list of files&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;paths_digest(manifest.path)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="d1" value="&lt;b&gt;Another check?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;by name: check_decode, group_by_hash, …&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Take all its runs since the last reset, oldest first&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;history + latest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Group the runs by their exact settings&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;params as sorted JSON&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="d2" value="&lt;b&gt;Another settings group?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;Take the group's latest run&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;even if it failed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;Copy status, error, timing, settings, stats and changes&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;status · duration_s · params · stats · changes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;Add the code version it ran on&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;git_commit · git_dirty&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b&gt;Note whether it ran on the same files&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;paths_digest_matches&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;b&gt;Count the earlier runs with these settings&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;earlier_runs = runs − 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s9" value="&lt;b&gt;Sort the check's entries by start time&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;started_at&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b&gt;Return one list of entries per check&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;{check_decode: [...], group_by_embeddings: [...], …}&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="1270" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue: in memory (reads only what build_report loaded)&lt;br&gt;yellow: decision&lt;br&gt;purple: start / result&lt;br&gt;&lt;font color='#666666'&gt;grey text: output key, function or example&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="20" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="in" value="&lt;b&gt;The input&lt;/b&gt;&lt;br&gt;build_report reads audits.json (load_audits) and keeps the entries since the last reset event (manifest_created or restart), grouped per check with the latest one last (latest_by_check). Older entries describe flags that are gone." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="150" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="why" value="&lt;b&gt;Why one entry per settings&lt;/b&gt;&lt;br&gt;Runs with different settings all shaped the manifest: tags pile up until a reset. group_by_embeddings with alexnet and with facenet are two configurations, not a run and its rerun." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="420" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="ex" value="&lt;b&gt;Example&lt;/b&gt;&lt;br&gt;group_by_embeddings ran alexnet 0.95 twice, then facenet-vggface2 0.95 once →&lt;br&gt;• alexnet, earlier_runs 1&lt;br&gt;• facenet-vggface2, earlier_runs 0&lt;br&gt;sorted by when they started" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="680" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="same" value="&lt;b&gt;paths_digest_matches: false&lt;/b&gt;&lt;br&gt;The check ran on a different set of files than the manifest now has: files were added, removed or renamed afterwards, so its numbers may be out of date." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="920" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="fail" value="&lt;b&gt;A failed rerun&lt;/b&gt;&lt;br&gt;If the latest run with some settings failed, that is the one shown, so the report says the last attempt did not finish." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="1080" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d2" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="next settings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.3;" edge="1" parent="1" source="s8" target="d2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="1070"/><mxPoint x="690" y="560"/></Array></mxGeometry></mxCell>
        <mxCell id="e11" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="s9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="24" y="580"/><mxPoint x="24" y="1180"/></Array></mxGeometry></mxCell>
        <mxCell id="e12" value="next check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.3;" edge="1" parent="1" source="s9" target="d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="1180"/><mxPoint x="720" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="e13" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="end"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="8" y="250"/><mxPoint x="8" y="1305"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
