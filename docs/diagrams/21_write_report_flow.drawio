<mxfile host="app.diagrams.net">
  <diagram id="write-report-flow" name="21 · write_report">
    <mxGraphModel dx="900" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="&lt;b&gt;write_report(report, path)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;generate_report, the very last write&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;Find the folder the JSON goes in&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.path.abspath · dirname&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Create the folder if it doesn't exist&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.makedirs(exist_ok=True)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Create a temporary file in that folder&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;tempfile.mkstemp · .report-….json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;Convert the report to plain JSON types&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;to_jsonable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;Write it as strict JSON, indented&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;json.dump · allow_nan=False · indent=2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;Rename it over validation_report.json&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.replace · one atomic step&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b&gt;Done&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;generate_report returns the path&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="conv" value="to_jsonable · walks the whole report" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="340" height="370" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;dicts: keys become strings&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;{1: …} → {'1': …}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="conv"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;tuples, sets and numpy arrays become lists&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;sets sorted, so the order is stable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="conv"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;numpy numbers become Python numbers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;np.int64(3) → 3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="conv"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;NaN and ±inf become null; dates and paths become text&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;aspect_ratio of a corrupt file is inf&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="conv"><mxGeometry x="20" y="290" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="e1" value="&lt;b&gt;Delete the temporary file, if it exists&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.remove&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="380" y="470" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="e2" value="&lt;b&gt;Raise the error again&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;BaseException: also Ctrl-C&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=20;" vertex="1" parent="1"><mxGeometry x="380" y="560" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="caller" value="&lt;b&gt;The run stops, even with --force&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;generate_report doesn't catch this error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="380" y="650" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="gap" value="&lt;b&gt;Gap: an old JSON can survive&lt;/b&gt;&lt;br&gt;Nothing deletes the previous validation_report.json first. If this write fails, the old one stays next to the new CSVs, sheet and summary, and describes an earlier run." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="760" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue: in memory&lt;br&gt;green: touches disk (resultdir/report/)&lt;br&gt;red: an error, passed on to the caller; red note: a gap found while drawing&lt;br&gt;dashed red arrow: if this step raises&lt;br&gt;box with a title: one helper function&lt;br&gt;&lt;font color='#666666'&gt;grey text: the call or an example&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="20" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="strict" value="&lt;b&gt;Why strict JSON&lt;/b&gt;&lt;br&gt;Python writes NaN and Infinity by default, which isn't valid JSON and breaks most parsers. allow_nan=False makes json.dump raise instead, as a last check after to_jsonable." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="last" value="&lt;b&gt;Why it is written last&lt;/b&gt;&lt;br&gt;Its outputs list names every file the run wrote. Writing it last means it only lists files that really exist." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="360" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="atomic" value="&lt;b&gt;Why a temp file and a rename&lt;/b&gt;&lt;br&gt;Anyone reading validation_report.json gets the old file or the new one, never half of one. Same pattern as write_review_sheet and append_audit." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="520" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s6" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="s4" target="conv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.85;exitY=1;entryX=0;entryY=0.2;" edge="1" parent="1" source="s4" target="e1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s5" target="e1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="s6" target="e1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="e1" target="e2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="e2" target="caller"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
