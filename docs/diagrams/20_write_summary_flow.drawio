<mxfile host="app.diagrams.net">
  <diagram id="write-summary-flow" name="20 · write_summary">
    <mxGraphModel dx="900" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="&lt;b&gt;write_summary(report, out_dir)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;generate_report, once the outputs list is final&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s1" value="build_blocks · sections in page order" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="340" height="690" as="geometry"/></mxCell>
        <mxCell id="h_s1_0" value="&lt;b&gt;Title, date and dataset fingerprint&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;_header · + a red banner if valid is false&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s1"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s1_1" value="&lt;b&gt;Summary: received, usable, review, exclude, unique&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;_summary · KPI tiles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s1"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s1_2" value="&lt;b&gt;Findings: each tag grouped by severity&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;_findings · descriptions from the tag catalog&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s1"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s1_3" value="&lt;b&gt;What is in the delivery: formats, sizes, folders&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;_profile · histograms of blur, brightness, …&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s1"><mxGeometry x="20" y="290" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s1_4" value="&lt;b&gt;Duplicates: levels table and largest groups&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;_duplicates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s1"><mxGeometry x="20" y="370" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s1_5" value="&lt;b&gt;Methods and thresholds: which checks ran, with which settings&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;_methods · fmt_params&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s1"><mxGeometry x="20" y="450" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s1_6" value="&lt;b&gt;Caveats: limits, uncommitted code, warnings&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;_caveats&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s1"><mxGeometry x="20" y="530" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s1_7" value="&lt;b&gt;Files: links to the other outputs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;_files · from report['outputs']&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s1"><mxGeometry x="20" y="610" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;Turn the report into a list of blocks&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;build_blocks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="435" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s2" value="render_html" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="840" width="340" height="290" as="geometry"/></mxCell>
        <mxCell id="h_s2_0" value="&lt;b&gt;One HTML snippet per block, text escaped&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;h1 · p · banner · kpis · table · list · links&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s2"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s2_1" value="&lt;b&gt;Draw each histogram as inline SVG&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;histogram_svg · dashed line at the threshold&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s2"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s2_2" value="&lt;b&gt;Fill the page template&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;string.Template · templates/report.html, CSS inside&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s2"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Render the blocks as HTML&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;render_html&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="955" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s3" value="render_markdown" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="1160" width="340" height="210" as="geometry"/></mxCell>
        <mxCell id="h_s3_0" value="&lt;b&gt;Tables with numbers right-aligned&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;| --- | ---: |, pipes escaped&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s3"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s3_1" value="&lt;b&gt;Charts become a pointer to the HTML&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;'Histograms are in the HTML version'&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="h_s3"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Render the same blocks as Markdown&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;render_markdown&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1235" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s4" value="_write_text · for each file" style="swimlane;html=1;startSize=34;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;collapsible=0;whiteSpace=wrap;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="1400" width="340" height="290" as="geometry"/></mxCell>
        <mxCell id="h_s4_0" value="&lt;b&gt;Create a temporary file next to the target&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;tempfile.mkstemp · .summary-…&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="h_s4"><mxGeometry x="20" y="50" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s4_1" value="&lt;b&gt;Write the text as UTF-8&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="h_s4"><mxGeometry x="20" y="130" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_s4_2" value="&lt;b&gt;Rename it over the target in one step&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;os.replace · on error, delete the temp file&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="h_s4"><mxGeometry x="20" y="210" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;Write report.html&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;_write_text&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1475" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;Write report.md&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;_write_text&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1555" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b&gt;Return ['report.html', 'report.md']&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="1730" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue: in memory&lt;br&gt;green: writes resultdir/report/&lt;br&gt;purple: start / result&lt;br&gt;box with a title: one helper function&lt;br&gt;&lt;font color='#666666'&gt;grey text: function or example&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="20" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="one" value="&lt;b&gt;One source of numbers&lt;/b&gt;&lt;br&gt;Blocks use only values in the report dict, the same dict that becomes validation_report.json, so the HTML, the Markdown and the JSON never disagree." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="160" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="fmt" value="&lt;b&gt;Number formatting&lt;/b&gt; · fmt_*&lt;br&gt;59,100 · 52.0% · '1 (&amp;lt;0.1%)' so a non-zero share never shows as 0.0% · 733.9 MB · '(top level)' for files directly in data_dir." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="320" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="first" value="&lt;b&gt;Render first, write second&lt;/b&gt;&lt;br&gt;Both pages are built in memory before anything is written, so an error while building them leaves no file at all." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="860" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="fail" value="&lt;b&gt;If writing fails&lt;/b&gt;&lt;br&gt;report.html may already be written when report.md fails. generate_report then removes both (remove_summary), so you never get one without the other; with --force the JSON gets a summary_failed issue." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="1420" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="self" value="&lt;b&gt;Self-contained HTML&lt;/b&gt;&lt;br&gt;CSS is in the template and charts are inline SVG: no scripts, no external links, so the page works offline and can be sent as one file." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="1000" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="h_s1_0" target="h_s1_1"><mxGeometry relative="1" as="geometry"/></mxCell>
