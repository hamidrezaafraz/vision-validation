                <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" value="&lt;b&gt;Compare every pair of hashes&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39; color=&#39;#666666&#39;&gt;hamming_pairs · chunked matmul on GPU/CPU&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="280" x="40" y="530" as="geometry"/>
                </mxCell>
                <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" value="&lt;b&gt;Keep pairs that differ in at most threshold bits&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39; color=&#39;#666666&#39;&gt;--hamming_threshold (inclusive)&lt;/font&gt;" vertex="1">
