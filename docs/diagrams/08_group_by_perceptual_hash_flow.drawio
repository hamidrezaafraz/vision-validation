                    <mxGeometry height="60" width="280" x="40" y="1400" as="geometry"/>
                </mxCell>
                <mxCell id="s12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" value="&lt;b&gt;Save manifest.csv&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39; color=&#39;#666666&#39;&gt;save_manifest&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="280" x="40" y="1490" as="geometry"/>
                </mxCell>
                <mxCell id="s13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" value="&lt;b&gt;Log the run in audits.json&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39; color=&#39;#666666&#39;&gt;@audited: pairs_found, groups_found, images_in_groups&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="280" x="40" y="1580" as="geometry"/>
                </mxCell>
                <mxCell id="end" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Back to dataset_cli&lt;/b&gt;" vertex="1">
                    <mxGeometry height="60" width="280" x="40" y="1680" as="geometry"/>
                </mxCell>
                <mxCell id="how" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;What a perceptual hash is&lt;/b&gt;&lt;br&gt;phash shrinks the image to 32×32 gray, keeps its 8×8 coarsest patterns (DCT) and stores 1 bit per pattern: above or below the median. Images that look alike get hashes that differ in only a few bits, even after resizing or re-saving." vertex="1">
                    <mxGeometry height="140" width="300" x="380" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="chain" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;Chaining&lt;/b&gt;&lt;br&gt;Groups follow links: if a~b and b~c, then a and c share a group even if they differ in more bits. The report flags unusually large groups as chaining suspects." vertex="1">
                    <mxGeometry height="100" width="300" x="380" y="850" as="geometry"/>
                </mxCell>
                <mxCell id="same" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;Same as group_by_hash&lt;/b&gt; (diagram 07)&lt;br&gt;Rows already review or drop can&#39;t be picked, and every unflagged image in the dataset becomes keep." vertex="1">
                    <mxGeometry height="110" width="300" x="380" y="1220" as="geometry"/>
                </mxCell>
                <mxCell id="legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue: in memory&lt;br&gt;green: touches disk (resultdir)&lt;br&gt;yellow: decision&lt;br&gt;orange: flag added (action · reason tag)&lt;br&gt;&lt;font color=&#39;#666666&#39;&gt;grey text: the function that does it&lt;/font&gt;" vertex="1">
                    <mxGeometry height="130" width="260" x="720" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="cache" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;The cache&lt;/b&gt;&lt;br&gt;embeddings/phash_hashes.npy holds the hashes and phash_hashes_indices.npy the manifest row of each. It is reused when it covers every row not dropped; rows come back in df order." vertex="1">
                    <mxGeometry height="130" width="280" x="720" y="294" as="geometry"/>
                </mxCell>
                <mxCell id="thr" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" value="&lt;b&gt;The threshold&lt;/b&gt;&lt;br&gt;Distance ≤ --hamming_threshold counts, so 0 means identical hashes only, and the tag near_duplicate_phash_4 means at most 4 bits apart." vertex="1">
                    <mxGeometry height="110" width="280" x="720" y="606" as="geometry"/>
                </mxCell>
